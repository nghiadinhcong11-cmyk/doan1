# Copy to .env only if your local tooling loads dotenv files.
# ASP.NET Core does not load .env automatically; use .NET User Secrets or
# process environment variables instead. These are examples only.
Jwt__Secret=replace-with-a-random-secret-of-at-least-32-bytes
Jwt__Issuer=RestaurantPOS
Jwt__Audience=RestaurantPOS
Jwt__ExpiryDays=7
# Supabase Session Pooler (use the value from Supabase Connect > Session pooler).
# Keep the password only in the environment or .NET User Secrets; never commit it.
ConnectionStrings__DefaultConnection=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.lizpcvayxcuwjgrxsvfe;Password=<supabase-database-password>;SSL Mode=Require;Trust Server Certificate=true
# Alternative variable accepted by the API (use one connection-string variable, not both).
SUPABASE_CONNECTION_STRING=Host=aws-0-ap-northeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.lizpcvayxcuwjgrxsvfe;Password=<supabase-database-password>;SSL Mode=Require;Trust Server Certificate=true
# Optional Development LAN mode: set DOAN_DEV_LAN_HOST in the PowerShell session
# before running scripts/setup-https.ps1; the selected LAN certificate must cover it in SAN.
