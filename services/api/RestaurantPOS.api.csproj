<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RestaurantPOS.api</RootNamespace>
    <UserSecretsId>RestaurantPOS-api-local</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- DTO/controller documentation is included in Swagger; unrelated internal models remain outside this warning policy. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Isolated diagnostics may leave generated C# under hidden temporary or
         intermediate folders. Keep those artifacts out of source compilation;
         SDK-generated assembly files are added by the build targets themselves. -->
    <Compile Remove="**/obj/**/*.cs" />
    <Compile Remove="**/.tmp-*/**/*.cs" />
    <Compile Remove="**/.*-obj/**/*.cs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

</Project>
